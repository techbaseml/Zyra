{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zyra",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zyra-ai-db",
      "database_id": "c4f040fc-3f51-4eba-918f-4e87d08f3da1",
      "migrations_dir": "drizzle",
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "DAILY_USER_LIMIT": "20",
    "DAILY_GLOBAL_LIMIT": "200",
    "DAILY_IP_LIMIT": "40",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "FREE_TIER_CONFIRMED": "true",
    "REGISTRATION_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFt2W38_Dh_oAm-i",
    "AUTH_CPU_VERIFIED": "false",
    "AUTH_CHECK_EXPIRES_AT": "1793451552152",
    "DAILY_TOKEN_BUDGET": "150000",
    "MINUTE_TOKEN_BUDGET": "8000",
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 },
  },
}
