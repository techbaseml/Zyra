# Copy to .dev.vars for LOCAL development only. Never commit .dev.vars.
APP_ENV=development
REGISTRATION_ENABLED=true
# Set true only with Groq Free + an unbilled Gemini project; code cannot detect billing tier.
FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
DAILY_USER_LIMIT=20
DAILY_GLOBAL_LIMIT=200
DAILY_IP_LIMIT=40
DAILY_TOKEN_BUDGET=150000
MINUTE_TOKEN_BUDGET=8000
# Production uses Cloudflare secrets. Localhost does not need Turnstile.
ABUSE_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AUTH_CPU_VERIFIED=false
